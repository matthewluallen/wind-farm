{
  "name": "wind-farm",
  "image": "debian:bookworm",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "portsAttributes": {
    "1880": {
      "label": "Farm HMI"
    },
    "8080": {
      "label": "Wireshark"
    }
  },
  "onCreateCommand": "apt update && apt install -y iproute2 && docker compose pull",
  "postStartCommand": "docker compose up -d"
}
